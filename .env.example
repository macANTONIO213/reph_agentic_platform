# Copy this file to .env and fill in values for local development.
# On Render, set these in the Environment tab of your service dashboard.

# Required — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Set to False in production (variable name used by settings.py)
DJANGO_DEBUG=True

# Comma-separated list of allowed hostnames (e.g. myapp.onrender.com,www.example.com)
ALLOWED_HOSTS=127.0.0.1,localhost

# Postgres connection string (leave blank to use SQLite locally)
# On Render this is set automatically when linked to a Postgres database
DATABASE_URL=

# Anthropic Claude API key
ANTHROPIC_API_KEY=

# OpenAI API key (optional)
OPENAI_API_KEY=

# Azure OpenAI (optional)
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# AWS Bedrock (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Generic HTTP adapter bearer token (optional)
HTTP_API_BEARER_TOKEN=

# Stabilization controls
# Rotate DJANGO_SECRET_KEY at least quarterly (and immediately after any incident).
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_REQUESTS_PER_WINDOW=120
CONNECTOR_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CONNECTOR_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
RETENTION_TELEMETRY_DAYS=30
RETENTION_SPANS_DAYS=30
RETENTION_SESSIONS_DAYS=90
RETENTION_RUNS_DAYS=90
PLATFORM_SLO_SUCCESS_RATE_TARGET=99.0
PLATFORM_SLO_P95_LATENCY_MS_TARGET=2000
PLATFORM_QUEUE_PENDING_WARN_THRESHOLD=100
PLATFORM_QUEUE_STALE_MINUTES=30
PLATFORM_ACTIVE_BUDGET_ALERTS_WARN_THRESHOLD=10
PLATFORM_ENTERPRISE_MIN_SCORE=85

# ── Phase 0: Durable execution ────────────────────────────────────────────────
# "db" (default, no broker needed) or "celery" (requires Redis + a running worker:
#   celery -A agentic_platform worker -l info --pool=solo   # --pool=solo on Windows
EXECUTION_BACKEND=db
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500
# Force inline execution without a broker (tests set this automatically):
CELERY_TASK_ALWAYS_EAGER=

# ── Phase 1: A2A server (outbound discoverability + invocation) ────────────────
# The external /a2a/ surface is OFF unless enabled. When on, external callers must
# present a bearer token from the comma-separated A2A_ACCESS_TOKENS list.
A2A_SERVER_ENABLED=
A2A_ACCESS_TOKENS=
# Public base URL advertised in agent cards (defaults to the request host):
A2A_PUBLIC_BASE_URL=

# ── Phase 1 stretch: MCP server (expose our governed tools at /a2a/mcp/) ───────
MCP_SERVER_ENABLED=
MCP_SERVER_TOKENS=
# Comma-separated allowlist of builtin tools to expose (default: registry_search):
MCP_SERVER_EXPOSED_TOOLS=

# ── Production hardening ───────────────────────────────────────────────────────
# Shared cache/broker — REQUIRED for multi-worker deployments so rate-limit and
# circuit-breaker counters are cluster-wide (else they go per-process).
REDIS_URL=
CACHE_URL=
# Structured logs for aggregation: "json" in prod, "plain" locally. LOG_LEVEL controls app logger.
LOG_FORMAT=plain
LOG_LEVEL=INFO
# Reliability: max execution attempts before a run/task is dead-lettered.
WORKFLOW_RUN_MAX_ATTEMPTS=3
ASYNC_TASK_MAX_ATTEMPTS=3
# Per-agent orchestrator circuit breaker.
AGENT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
AGENT_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
# Outbound LLM client timeouts (seconds) — a hung upstream must not pin a worker.
LLM_CLIENT_TIMEOUT_SECONDS=120
LLM_CLIENT_MAX_RETRIES=2
BROKER_ROUTER_TIMEOUT_SECONDS=20
# SSRF egress hardening — enable in production to defeat DNS-rebinding / internal targets.
NET_GUARD_RESOLVE_DNS=
NET_GUARD_BLOCK_PRIVATE=
# Comma-separated bearer tokens a Prometheus/Grafana scraper may present to /api/v1/metrics/.
METRICS_SCRAPE_TOKENS=
# Require an active EvalSuite before promoting agents at/above this risk tier (0 = off).
EVAL_GATE_REQUIRE_SUITE_MIN_TIER=0
